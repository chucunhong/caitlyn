# Copy to .env and fill in. .env is git-ignored.
# Alibaba Cloud Model Studio API key (Singapore region): https://modelstudio.console.alibabacloud.com/
ALIBABA_CLOUD_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# Workspace ID (Model Studio > Settings > Workspace); used to build
# https://<WorkspaceId>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
ALIBABA_CLOUD_WORKSPACE_ID=
# Token Plan (subscription) key, used when llm.provider = token_plan in configs/run.yaml
TOKEN_PLAN_API_KEY=sk-sp-xxxxxxxx
# TOKEN_PLAN_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# Optional: full endpoint override
# ALIBABA_CLOUD_BASE_URL=https://<WorkspaceId>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
